# Copy to .env for local docker profile (never commit .env)

# Docker Compose (PostgreSQL)
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change-me

# Spring Boot docker profile (spring.profiles.active=docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tickets
SPRING_DATASOURCE_USERNAME=tickets
SPRING_DATASOURCE_PASSWORD=change-me
